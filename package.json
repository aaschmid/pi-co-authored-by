{
	"name": "pi-co-authored-by",
	"version": "0.4.0",
	"description": "A Pi extension that automatically appends Co-Authored-By and Generated-By git trailers to commit messages with the model name and pi version",
	"author": "Bruno Garcia",
	"contributors": [
		"Andreas Schmid"
	],
	"license": "MIT",
	"homepage": "https://github.com/aaschmid/pi-co-authored-by#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/aaschmid/pi-co-authored-by"
	},
	"keywords": [
		"pi-package",
		"git",
		"co-authored-by",
		"pi-extension"
	],
	"files": [
		"extensions/co-authored-by.ts",
		"lib/commit.ts",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@earendil-works/pi-coding-agent": "^0.84.3",
		"@types/node": "^22.0.0",
		"typescript": "^7.0.2",
		"vitest": "^4.0.0"
	},
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"check": "biome check"
	}
}
